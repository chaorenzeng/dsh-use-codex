{
  "name": "dsh-use-codex",
  "displayName": "DSH Use Codex",
  "description": "通过 DeepSeek Harness 工具调用本机 Codex CLI 执行独立任务；danger-full-access 支持宿主许可 + 运行时开关双重授权。",
  "version": "0.4.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.1 <0.3.0"
  },
  "files": [
    "lib/",
    "README.md",
    "README.en.md",
    "SECURITY.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "codex",
    "codex-cli",
    "agent",
    "delegation"
  ],
  "scripts": {
    "test": "node selftest.mjs",
    "prepack": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/chaorenzeng/dsh-use-codex/archive/refs/heads/main.tar.gz",
      "git": "https://github.com/chaorenzeng/dsh-use-codex.git"
    }
  },
  "author": "chaorenzeng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaorenzeng/dsh-use-codex.git"
  },
  "homepage": "https://github.com/chaorenzeng/dsh-use-codex#readme",
  "bugs": {
    "url": "https://github.com/chaorenzeng/dsh-use-codex/issues"
  }
}
